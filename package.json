    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "acorn": "^8.15.0",
    "axe-core": "^4.11.0",
    "eslint-scope": "^8.4.0",
    "magic-string": "^0.30.0",
    "prettier": "^3.9.10",
    "vite": "^7.2.0",
    "vitest": "^5.1.0"
